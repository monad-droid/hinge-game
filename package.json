{
  "name": "debatable",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "watch": "vite build --watch",
    "build": "vite build",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json",
    "db:local": "wrangler d1 execute debatable-db --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute debatable-db --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute debatable-db --local --file=./migrations/0002-flappy.sql",
    "db:migrate:remote": "wrangler d1 execute debatable-db --remote --file=./migrations/0002-flappy.sql",
    "db:migrate-drawing:local": "wrangler d1 execute debatable-db --local --file=./migrations/0003-drawing.sql",
    "db:migrate-drawing:remote": "wrangler d1 execute debatable-db --remote --file=./migrations/0003-drawing.sql",
    "db:migrate-saves:local": "wrangler d1 execute debatable-db --local --file=./migrations/0004-card-saves.sql",
    "db:migrate-saves:remote": "wrangler d1 execute debatable-db --remote --file=./migrations/0004-card-saves.sql",
    "stats:saves": "wrangler d1 execute debatable-db --remote --command \"SELECT day, count FROM card_saves ORDER BY day DESC LIMIT 60\"",
    "stats:games": "wrangler d1 execute debatable-db --remote --command \"SELECT date(created_at/1000,'unixepoch') AS day, COUNT(*) AS created, SUM(p2_submitted_at IS NOT NULL) AS completed FROM games GROUP BY day ORDER BY day DESC\"",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
